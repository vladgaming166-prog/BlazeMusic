# Optional environment-variable form of the same keys as local.properties.example.
# GitHub Actions injects these from repository Secrets. Never commit real values.

YOUTUBE_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=blazemuzix://callback
GOOGLE_WEB_CLIENT_ID=

