<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/short_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blaze_black">

    <ImageView
        android:id="@+id/short_artwork"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <FrameLayout
        android:id="@+id/short_player_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_gradient_bottom" />

    <ImageButton
        android:id="@+id/short_play"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_circle_translucent"
        android:contentDescription="@string/action_play"
        android:padding="20dp"
        android:scaleType="fitCenter"
        app:srcCompat="@drawable/ic_play"
        app:tint="@color/white" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|right"
        android:layout_marginRight="@dimen/space_s"
        android:layout_marginBottom="96dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/short_save"
            style="@style/Widget.BlazeMuzix.IconButton"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:contentDescription="@string/action_save"
            app:srcCompat="@drawable/ic_bookmark_border"
            app:tint="@color/white" />

        <ImageButton
            android:id="@+id/short_favorite"
            style="@style/Widget.BlazeMuzix.IconButton"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:layout_marginTop="@dimen/space_s"
            android:contentDescription="@string/action_favorite"
            app:srcCompat="@drawable/ic_favorite_border"
            app:tint="@color/white" />

        <ImageButton
            android:id="@+id/short_share"
            style="@style/Widget.BlazeMuzix.IconButton"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:layout_marginTop="@dimen/space_s"
            android:contentDescription="@string/action_share"
            app:srcCompat="@drawable/ic_share"
            app:tint="@color/white" />

        <ImageButton
            android:id="@+id/short_open"
            style="@style/Widget.BlazeMuzix.IconButton"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:layout_marginTop="@dimen/space_s"
            android:contentDescription="@string/action_open_in_youtube"
            app:srcCompat="@drawable/ic_open_in_new"
            app:tint="@color/white" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingLeft="@dimen/space_l"
        android:paddingRight="72dp"
        android:paddingBottom="@dimen/space_xl">

        <TextView
            android:id="@+id/short_source"
            style="@style/Widget.BlazeMuzix.SourceBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_dark"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/short_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.BlazeMuzix.Title"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/short_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:ellipsize="end"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.BlazeMuzix.Body"
            android:textColor="@color/white_70" />

        <TextView
            android:id="@+id/short_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:textAppearance="@style/TextAppearance.BlazeMuzix.Caption"
            android:textColor="@color/white_70"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
