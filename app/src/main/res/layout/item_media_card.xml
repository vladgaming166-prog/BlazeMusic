<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_root"
    android:layout_width="@dimen/artwork_card"
    android:layout_height="wrap_content"
    android:layout_marginRight="@dimen/space_m"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingBottom="@dimen/space_xs">

    <FrameLayout
        android:layout_width="@dimen/artwork_card"
        android:layout_height="@dimen/artwork_card">

        <ImageView
            android:id="@+id/card_artwork"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/card_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|right"
            android:layout_margin="@dimen/space_s"
            android:background="@drawable/bg_badge_dark"
            android:includeFontPadding="false"
            android:paddingLeft="6dp"
            android:paddingTop="3dp"
            android:paddingRight="6dp"
            android:paddingBottom="3dp"
            android:textAppearance="@style/TextAppearance.BlazeMuzix.Label"
            android:textColor="@color/white"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/card_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAppearance="@style/TextAppearance.BlazeMuzix.Subtitle"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/card_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:textAppearance="@style/TextAppearance.BlazeMuzix.Caption"
        android:textSize="12sp" />
</LinearLayout>
