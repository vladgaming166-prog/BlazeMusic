<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/space_l"
        android:paddingTop="@dimen/space_m"
        android:paddingRight="@dimen/space_s">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/nav_library"
            android:textAppearance="@style/TextAppearance.BlazeMuzix.Headline" />

        <ImageButton
            android:id="@+id/library_add"
            style="@style/Widget.BlazeMuzix.IconButton"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:contentDescription="@string/action_new_playlist"
            android:src="@drawable/ic_add" />

        <ImageButton
            android:id="@+id/library_rescan"
            style="@style/Widget.BlazeMuzix.IconButton"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:contentDescription="@string/action_rescan"
            android:src="@drawable/ic_refresh" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/library_tabs_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:clipToPadding="false"
        android:paddingLeft="@dimen/space_l"
        android:paddingRight="@dimen/space_l"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/library_tabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="@dimen/space_s"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/tab_local"
                style="@style/Widget.BlazeMuzix.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/library_local" />

            <com.google.android.material.chip.Chip
                android:id="@+id/tab_favorites"
                style="@style/Widget.BlazeMuzix.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/library_favorites" />

            <com.google.android.material.chip.Chip
                android:id="@+id/tab_recent"
                style="@style/Widget.BlazeMuzix.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/library_recent" />

            <com.google.android.material.chip.Chip
                android:id="@+id/tab_playlists"
                style="@style/Widget.BlazeMuzix.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/library_playlists" />

            <com.google.android.material.chip.Chip
                android:id="@+id/tab_saved"
                style="@style/Widget.BlazeMuzix.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/library_saved" />

            <com.google.android.material.chip.Chip
                android:id="@+id/tab_downloads"
                style="@style/Widget.BlazeMuzix.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/library_downloads" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/library_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/space_l"
        android:paddingTop="@dimen/space_m"
        android:paddingRight="@dimen/space_l"
        android:paddingBottom="@dimen/space_xs">

        <TextView
            android:id="@+id/library_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.BlazeMuzix.Caption" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/library_shuffle"
            style="@style/Widget.BlazeMuzix.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_shuffle"
            app:icon="@drawable/ic_shuffle"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/library_play_all"
            style="@style/Widget.BlazeMuzix.Button.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/space_s"
            android:text="@string/action_play"
            app:icon="@drawable/ic_play"
            app:iconGravity="textStart" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/library_notice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_l"
        android:layout_marginRight="@dimen/space_l"
        android:layout_marginBottom="@dimen/space_s"
        android:background="@drawable/bg_offline_banner"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_m"
        android:visibility="gone">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_info"
            app:tint="@color/bm_on_warning_container" />

        <TextView
            android:id="@+id/library_notice_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/space_m"
            android:layout_weight="1"
            android:text="@string/library_downloads_empty_message"
            android:textAppearance="@style/TextAppearance.BlazeMuzix.Caption"
            android:textColor="@color/bm_on_warning_container" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/library_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/space_l"
            android:scrollbars="vertical" />

        <include
            android:id="@+id/library_state"
            layout="@layout/layout_state" />
    </FrameLayout>
</LinearLayout>
